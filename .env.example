# =============================================================
# TECHIN 510 Week 7 - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com/settings/keys
# 1. Sign in or create an account at console.anthropic.com
# 2. Go to Settings > API Keys
# 3. Click "Create Key" and copy the value
# 4. You get $5 of free credits when you sign up
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Debug mode (optional) - set to "true" to see verbose logging
DEBUG_MODE=false
